<Window x:Class="Wpf_Stationery.FilterWindows"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Wpf_Stationery"
        mc:Ignorable="d"
        Title="FilterWindows" Height="260" Width="310">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"></ColumnDefinition>
            <ColumnDefinition Width="60"></ColumnDefinition>
            <ColumnDefinition Width="50"></ColumnDefinition>
            <ColumnDefinition Width="80"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions >
            <RowDefinition Height="40"></RowDefinition>
            <RowDefinition Height="40"></RowDefinition>
            <RowDefinition Height="40"></RowDefinition>
            <RowDefinition Height="40"></RowDefinition>
            <RowDefinition Height="20"></RowDefinition>
            <RowDefinition Height="40"></RowDefinition>
        </Grid.RowDefinitions>
        
        <Label Margin="5,5,5,5" FontFamily="Bahnschrift" Foreground="#275879" FontSize="17" Grid.Row="0" Grid.Column="0">Threshold</Label>
        <Label Margin="5,5,5,5" FontFamily="Bahnschrift" Foreground="#275879" FontSize="17" Grid.Row="1" Grid.Column="0">Location</Label>
        <Label Margin="5,5,5,5" FontFamily="Bahnschrift" Foreground="#275879" FontSize="17" Grid.Row="2" Grid.Column="0">Type</Label>
        <Label Margin="5,5,5,5" FontFamily="Bahnschrift" Foreground="#275879" FontSize="17" Grid.Row="3" Grid.Column="0">Quantity</Label>

        <!--<TextBlock Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="1" Margin="5,5,5,5" FontSize="15" VerticalAlignment="Center" FontFamily="{StaticResource ResourceKey=FaFreeSolid}" Foreground="black"><Run Text="&lt;"/></TextBlock>-->
        <Button Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="1" Margin="5,5,5,5" FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Left" Width="20" FontFamily="{StaticResource ResourceKey=FaFreeSolid}" Foreground="black"><Run Text="&lt;"/></Button>
        <Button Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="1" Margin="30,5,5,5" FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Right" Width="20" FontFamily="{StaticResource ResourceKey=FaFreeSolid}" Foreground="black"><Run Text="&gt;"/></Button>
        <Button Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="1" FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Center" Width="20" FontFamily="{StaticResource ResourceKey=FaFreeSolid}" Foreground="black">
            <Run Text="&#61;"/>
        </Button>
        <Button Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="1" FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Center" Width="20" FontFamily="{StaticResource ResourceKey=FaFreeSolid}" Foreground="black">
            <Run Text="&#61;"/>
        </Button>
        <Button Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="1" Margin="5,5,5,5"  FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Left" Width="20" FontFamily="{StaticResource ResourceKey=FaFreeSolid}" Foreground="black">
            <Run Text="&lt;"/>
        </Button>
        <Button Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="1" Margin="30,5,5,5" FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Right" Width="20" FontFamily="{StaticResource ResourceKey=FaFreeSolid}" Foreground="black">
            <Run Text="&gt;"/>
        </Button>
        
        <Border Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="2" Width="100" HorizontalAlignment="Left" Margin="15,5,5,5" BorderBrush="#275879" BorderThickness="1" CornerRadius="5" RenderTransformOrigin="0.502,0.804">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform AngleX="-0.582"/>
                    <RotateTransform/>
                    <TranslateTransform X="-0.305"/>
                </TransformGroup>
            </Border.RenderTransform>
            <TextBox Margin="7,0,4,0" Height="14" Foreground="Gray" VerticalAlignment="Center" BorderThickness="0" FontSize="10" FontFamily="Bahnschrift" Name="thresholdText"/>
        </Border>
        <Border Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Width="100" Margin="5,5,5,5" BorderBrush="#275879" BorderThickness="1" CornerRadius="5" RenderTransformOrigin="0.502,0.804">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform AngleX="-0.582"/>
                    <RotateTransform/>
                    <TranslateTransform X="-0.305"/>
                </TransformGroup>
            </Border.RenderTransform>
            <TextBox Margin="7,0,4,0" Height="14" Foreground="Gray" VerticalAlignment="Center" BorderThickness="0" FontSize="10" FontFamily="Bahnschrift" Name="locationText"/>
        </Border>
        <Border Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" Width="100" Margin="5,5,5,5" BorderBrush="#275879" BorderThickness="1" CornerRadius="5" RenderTransformOrigin="0.502,0.804">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform AngleX="-0.582"/>
                    <RotateTransform/>
                    <TranslateTransform X="-0.305"/>
                </TransformGroup>
            </Border.RenderTransform>
            <TextBox Margin="7,0,4,0" Height="14" Foreground="Gray" VerticalAlignment="Center" BorderThickness="0" FontSize="10" FontFamily="Bahnschrift" Name="typeText"/>
        </Border>
        <Border Grid.Row="3" Grid.Column="2" Grid.ColumnSpan="2" Width="100" Margin="5,5,5,5" BorderBrush="#275879" BorderThickness="1" CornerRadius="5" RenderTransformOrigin="0.502,0.804">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform AngleX="-0.582"/>
                    <RotateTransform/>
                    <TranslateTransform X="-0.305"/>
                </TransformGroup>
            </Border.RenderTransform>
            <TextBox Margin="7,0,4,0" Height="14" Foreground="Gray" VerticalAlignment="Center" BorderThickness="0" FontSize="10" FontFamily="Bahnschrift" Name="quantityText"/>
        </Border>

        <Button Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Margin="5,5,5,5" FontSize="17" FontFamily="Bahnschrift" Foreground="#275879" BorderThickness="0" Background="#E9EAEC" Width="80" Height="30" VerticalAlignment="Center" Click="ButtonSvuota_Click">Svuota
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="6"/>
                </Style>
            </Button.Resources>
        </Button>
        <Button Grid.Row="5" Grid.Column="3" Grid.ColumnSpan="1" Margin="5,5,5,5" Name="Save" FontSize="17" FontFamily="Bahnschrift" Foreground="White" Background="#003d63" Height="30" BorderThickness="0" VerticalAlignment="Top" Content="Save" Click="Button_Save">
            <Button.Resources>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="CornerRadius" Value="6" />
                </Style>
            </Button.Resources>
        </Button>


    </Grid>
</Window>
