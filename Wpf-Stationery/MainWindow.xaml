<Window x:Class="Alten_Stationery.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Alten_Stationery"
        mc:Ignorable="d"
        Title="Login" Height="700" Width="1350"  Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="219*"/>
            <RowDefinition Height="481*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="1.5*"/>
        </Grid.ColumnDefinitions>
        <Border CornerRadius="10 0 0 10" BorderThickness="0" Grid.RowSpan="2" >
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#036e8e" Offset="0"/>
                    <GradientStop Color="#036e8e" Offset="1"/>


                </LinearGradientBrush>
            </Border.Background>
            <Grid >
                <Canvas Background="#003d63">
                    <Polygon Points="0,530 0,0 450,0" Fill="#045a92" Height="639" Width="479" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                    <Line X1="480" Y1="0" X2="-28" Y2="600" Stroke="#7abeea" StrokeThickness="45" Height="545" Width="453" HorizontalAlignment="Center" VerticalAlignment="Center" Canvas.Left="-2" />
                    <Polygon Points="5,165 90,30 165,165" Height="180" Width="188" Fill="#2c80b7" Canvas.Left="217" Canvas.Top="386"/>
                    <Polygon Points="21,231 126,42 231,231" Height="237" Width="260" Fill="#2c80b7" Canvas.Left="234" Canvas.Top="44" RenderTransformOrigin="0.5,0.5">
                        <Polygon.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform/>
                                <SkewTransform/>
                                <RotateTransform Angle="30.075"/>
                                <TranslateTransform/>
                            </TransformGroup>
                        </Polygon.RenderTransform>
                    </Polygon>
                    <Ellipse
                         Width="90"
                         Height="55"
                         Canvas.Left="279"
                         Canvas.Top="583"
                         Stretch="Fill" 
                           Fill="#2c80b7" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <Ellipse.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform/>
                                <SkewTransform AngleY="-0.139"/>
                                <RotateTransform Angle="180.456"/>
                                <TranslateTransform Y="-0.11" X="0.001"/>
                            </TransformGroup>
                        </Ellipse.RenderTransform>
                        <Ellipse.Clip>
                            <RectangleGeometry Rect="0,40,80,80"/>
                        </Ellipse.Clip>
                    </Ellipse>
                </Canvas>

            </Grid>

        </Border>
        <Border Background="White" Grid.Column="1" Grid.RowSpan="2" >

            <Grid>

                <TextBlock  HorizontalAlignment="Center" FontFamily="Bahnschrift" FontWeight="UltraBold" FontSize="50" Margin="0,90,0,500" Foreground="#003d63">Sign in to App</TextBlock>
                <TextBlock FontFamily="{StaticResource FaFreeSolid}" Text="&#xf508;" Foreground="#275879" Margin="0,179,0,0" FontSize="150" HorizontalAlignment="Center" VerticalAlignment="Top"></TextBlock>
                <Border Margin="210,354,210,0" BorderBrush="#275879" BorderThickness="5" CornerRadius="5" RenderTransformOrigin="0.502,0.804" VerticalAlignment="Top">
                    <Border.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform/>
                            <SkewTransform AngleX="-0.582"/>
                            <RotateTransform/>
                            <TranslateTransform X="-0.305"/>
                        </TransformGroup>
                    </Border.RenderTransform>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock  FontSize="20" Margin="15 " FontFamily="{StaticResource ResourceKey=FaFreeSolid}" Foreground="#275879" Width="21" ><Run Text="envelope"/></TextBlock>
                        <TextBox x:Name="email" Text="{Binding Email}" Foreground="Gray" Margin="10" BorderThickness="0" FontSize="25" FontFamily="Bahnschrift" Width="316"  />
                    </StackPanel>


                </Border>
                <Border Margin="210,450,210,0" BorderBrush="#275879" BorderThickness="5" CornerRadius="5" RenderTransformOrigin="0.502,0.804" VerticalAlignment="Top">
                    <Border.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform/>
                            <SkewTransform AngleX="-0.582"/>
                            <RotateTransform/>
                            <TranslateTransform X="-0.305"/>
                        </TransformGroup>
                    </Border.RenderTransform>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock  FontSize="20" Margin="16 " FontFamily="{StaticResource ResourceKey=FaFreeSolid}" Foreground="#275879" Width="19" ><Run Text="lock"/></TextBlock>
                        <TextBox x:Name="password" Text="{Binding Password}" Foreground="Gray" Margin="10" BorderThickness="0" FontSize="25" FontFamily="Bahnschrift" Width="314" TextChanged="password_TextChanged" />
                    </StackPanel>


                </Border>

                <Button  FontSize="25" FontFamily="Bahnschrift" Foreground="White" Background="#003d63" Height="60" BorderThickness="0" VerticalAlignment="Top" Margin="285,560,285,0" Content="Login" RenderTransformOrigin="0.5,0.5" Click="Button_Click">
                    <Button.Resources>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="CornerRadius" Value="20" />
                        </Style>
                    </Button.Resources>
                    <Button.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform ScaleX="1"/>
                            <SkewTransform/>
                            <RotateTransform/>
                            <TranslateTransform/>
                        </TransformGroup>
                    </Button.RenderTransform>
                </Button>


            </Grid>
        </Border>
    </Grid>

</Window>